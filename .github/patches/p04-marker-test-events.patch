+def _send_viewport_mouse(view,event_type,pos,button,buttons):
+    """Send an exact mouse event through the real QGraphicsView viewport."""
+    viewport=view.viewport()
+    local=QPointF(pos)
+    global_pos=QPointF(viewport.mapToGlobal(pos))
+    event=QMouseEvent(event_type,local,global_pos,button,buttons,Qt.KeyboardModifier.NoModifier)
+    QCoreApplication.sendEvent(viewport,event)
+
+
+def _drag_viewport(view,start,end,app):
+    # QTest press establishes Qt's real scene mouse grab; explicit move/release
+    # retain the pressed-button state and exact coordinates under offscreen Qt.
+    from PySide6.QtTest import QTest
+    QTest.mousePress(view.viewport(),Qt.MouseButton.LeftButton,pos=start)
+    app.processEvents()
+    _send_viewport_mouse(view,QEvent.Type.MouseMove,end,
+        Qt.MouseButton.NoButton,Qt.MouseButton.LeftButton)
+    app.processEvents()
+    _send_viewport_mouse(view,QEvent.Type.MouseButtonRelease,end,
+        Qt.MouseButton.LeftButton,Qt.MouseButton.NoButton)
+    app.processEvents()
+
+
