{
  "manifest_version": 3,
  "name": "Fonesi session bridge",
  "version": "0.1.0",
  "description": "User-consented session bridge for app-owned Chrome profiles",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.facebook.com/*",
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://*.threads.com/*",
    "https://*.threads.net/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.bilibili.com/*",
    "https://*.douyin.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.kuaishou.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
